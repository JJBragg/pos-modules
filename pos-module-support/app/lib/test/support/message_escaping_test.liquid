{% doc %}
  @param {object} contract - The test contract object
{% enddoc %}
{% liquid
  # Escaped text in a stored message must stay text on the ticket page and in
  # the outgoing email: a subject quoted by the acknowledgement, a note, a reply.
  assign body = '<p>&lt;script&gt;alert(1)&lt;/script&gt;&lt;img src=x onerror=alert(2)&gt;</p>'
  assign requester = { "id": "1", "name": "Ann", "emails": ["ann@example.com"] }
  assign profiles = {}
  assign no_attachments = []

  assign kinds = 'system,agent,note' | split: ','
  for kind in kinds
    assign message = { "id": "1", "author_type": "agent", "visibility": "public", "delivery_state": "sent", "created_at": "2026-10-30T10:00:00Z" }
    assign message.body_html = body
    if kind == 'system'
      assign message.author_type = 'system'
    elsif kind == 'note'
      assign message.visibility = 'internal'
    endif
    capture page
      render 'modules/support/ticket/message', message: message, attachments: no_attachments, requester: requester, profiles: profiles
    endcapture
    assign live = false
    if page contains '<script>' or page contains '<img src=x'
      assign live = true
    endif
    assign field = kind | append: ' message body stays text'
    function contract = 'modules/tests/assertions/equal', contract: contract, given: live, expected: false, field_name: field
    assign kept = false
    if page contains '&lt;script&gt;'
      assign kept = true
    endif
    assign field = kind | append: ' message body shown escaped'
    function contract = 'modules/tests/assertions/equal', contract: contract, given: kept, expected: true, field_name: field
  endfor

  # a customer's plain text is printed with {{ }} only, which escapes it once on
  # an HTML page; an extra escape filter showed entities as text. The test runner
  # serves JavaScript, where {{ }} does not escape, so here the text comes out as
  # typed and any entity means the partial escaped it itself. (E2E covers markup.)
  assign message = { "id": "2", "author_type": "customer", "visibility": "public", "created_at": "2026-10-30T10:00:00Z" }
  assign message.body_text = "It's broken & we <3"
  capture page
    render 'modules/support/ticket/message', message: message, attachments: no_attachments, requester: requester, profiles: profiles
  endcapture
  assign doubled = false
  if page contains '&#39;' or page contains '&amp;' or page contains '&lt;3'
    assign doubled = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: doubled, expected: false, field_name: 'customer text not escaped twice'

  # inline images in the original email use the file's signed URL: the sandboxed frame has no session
  assign message.body_html = '<p><img src="/support-desk/attachments/77" alt="x"></p>'
  assign inline = { "id": "77", "filename": "x.png", "size": 10, "file": { "url": "https://files.example/x.png?signature=1" } }
  assign inline_list = []
  assign inline_list << inline
  capture page
    render 'modules/support/ticket/message', message: message, attachments: inline_list, requester: requester, profiles: profiles
  endcapture
  assign signed = false
  if page contains 'files.example/x.png?signature=1'
    assign signed = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: signed, expected: true, field_name: 'inline image uses the signed file URL'
  assign session_link = false
  if page contains 'src=&quot;/support-desk/attachments/77' or page contains 'src="/support-desk/attachments/77'
    assign session_link = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: session_link, expected: false, field_name: 'inline image does not use the session-only attachment link'

  assign ticket = { "number": 1, "subject": "S" }
  capture email
    render 'modules/support/emails/reply', body_html: body, signature_html: body, brand: null, delimiter: 'D', ticket: ticket
  endcapture
  assign live = false
  if email contains '<script>' or email contains '<img src=x'
    assign live = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: live, expected: false, field_name: 'reply email body stays text'
%}
