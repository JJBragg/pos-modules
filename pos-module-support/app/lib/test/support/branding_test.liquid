{% doc %}
  @param {object} contract - The test contract object
{% enddoc %}
{% liquid
  function before = 'modules/support/helpers/settings'
  assign original_override = before.branding_override | default: {}

  # default name from the instance domain (#130, PRD WL-5)
  function n = 'modules/support/helpers/default_app_name', host: 'support-development.staging.oregon.platform-os.com'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: n, expected: 'Support Development', field_name: 'platformOS host gives its first label'
  function n = 'modules/support/helpers/default_app_name', host: 'www.Nordvik-Rail.no:443'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: n, expected: 'nordvik-rail.no', field_name: 'custom domain without www and port'
  function n = 'modules/support/helpers/default_app_name', host: ''
  function contract = 'modules/tests/assertions/equal', contract: contract, given: n, expected: 'Support', field_name: 'no host falls back to the translation'

  # the sidebar logo follows rail_theme, then theme_mode, then the device (#125)
  assign b = { "app_name": "Nordvik", "logo_url": "https://x.test/light.svg", "logo_dark_url": "https://x.test/dark.svg", "theme_mode": "light", "rail_theme": "dark" }
  capture out
    render 'modules/support/brand', brand: b
  endcapture
  assign shows_dark = out | matches: 'src="https://x.test/dark.svg"'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: shows_dark, expected: true, field_name: 'dark rail shows the dark logo in light mode'
  assign b.rail_theme = 'light'
  assign b.theme_mode = 'dark'
  capture out
    render 'modules/support/brand', brand: b
  endcapture
  assign shows_dark = out | matches: 'dark\.svg'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: shows_dark, expected: false, field_name: 'light rail shows the light logo in dark mode'
  assign b.rail_theme = 'auto'
  assign b.theme_mode = 'auto'
  capture out
    render 'modules/support/brand', brand: b
  endcapture
  assign follows_device = out | matches: 'prefers-color-scheme: dark'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: follows_device, expected: true, field_name: 'auto rail follows the device without the script'
  assign b.theme_mode = 'light'
  capture out
    render 'modules/support/brand', brand: b
  endcapture
  assign script_picks = out | matches: 'data-support-logo-dark="https://x.test/dark.svg"'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: script_picks, expected: true, field_name: 'auto rail lets the script pick from the rail colour'

  # Appearance: host removes the override, the others set it (#129)
  assign p = { "only": "theme_mode", "theme_mode": "light" }
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function s = 'modules/support/helpers/settings'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: s.branding_override.theme_mode, expected: 'light', field_name: 'appearance light saved'
  assign p.theme_mode = 'host'
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: true, field_name: 'follow the host app accepted'
  function s = 'modules/support/helpers/settings'
  assign keys = s.branding_override | default: {} | hash_keys
  assign has_mode = false
  if keys contains 'theme_mode'
    assign has_mode = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: has_mode, expected: false, field_name: 'follow the host app removes the appearance override'
  assign p.theme_mode = 'sepia'
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'unknown appearance refused'

  # dark logo, background colour, favicon and sidebar logo can be overridden (#128)
  assign p = { "use_host": "false", "logo_url": "https://x.test/l.svg", "logo_dark_url": "https://x.test/d.svg", "background_color": "#0E5C4A", "favicon_url": "https://x.test/f.ico", "rail_theme": "dark" }
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: true, field_name: 'logo, colour and favicon overrides saved'
  function brand = 'modules/support/helpers/branding'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: brand.logo_dark_url, expected: 'https://x.test/d.svg', field_name: 'dark logo override'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: brand.background_color, expected: '#0e5c4a', field_name: 'background colour override'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: brand.favicon_url, expected: 'https://x.test/f.ico', field_name: 'favicon override'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: brand.rail_theme, expected: 'dark', field_name: 'sidebar logo override'
  assign bad = { "use_host": "false", "rail_theme": "purple" }
  function r = 'modules/support/commands/settings_sections/branding', params: bad
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'unknown sidebar logo choice refused'
  assign bad = { "use_host": "false", "favicon_url": "http://x.test/f.ico" }
  function r = 'modules/support/commands/settings_sections/branding', params: bad
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'non-https favicon refused'

  # uploaded images (spec 08 §5, WL-7): checked before anything is stored
  assign png = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII='
  assign file = { "content_base64": null, "content_type": "image/png", "filename": "logo.png" }
  assign file.content_base64 = png
  function e = 'modules/support/commands/branding/check_image', key: 'logo_url', file: file
  function contract = 'modules/tests/assertions/equal', contract: contract, given: e, expected: null, field_name: 'png logo accepted'
  assign html = '<html>hi</html>' | base64_encode
  assign fake = { "content_type": "image/png", "filename": "x.png" }
  assign fake.content_base64 = html
  function e = 'modules/support/commands/branding/check_image', key: 'logo_url', file: fake
  function contract = 'modules/tests/assertions/equal', contract: contract, given: e, expected: 'modules/support/settings.errors.image_type', field_name: 'file that is not a png refused'
  assign svg = '<svg xmlns="http://www.w3.org/2000/svg" onload="alert(1)"></svg>' | base64_encode
  assign bad_svg = { "content_type": "image/svg+xml", "filename": "x.svg" }
  assign bad_svg.content_base64 = svg
  function e = 'modules/support/commands/branding/check_image', key: 'logo_url', file: bad_svg
  function contract = 'modules/tests/assertions/equal', contract: contract, given: e, expected: 'modules/support/settings.errors.image_unsafe', field_name: 'svg with an event handler refused'
  assign svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 10 10"><rect width="10" height="10"/></svg>' | base64_encode
  assign good_svg = { "content_type": "image/svg+xml", "filename": "x.svg" }
  assign good_svg.content_base64 = svg
  function e = 'modules/support/commands/branding/check_image', key: 'logo_url', file: good_svg
  function contract = 'modules/tests/assertions/equal', contract: contract, given: e, expected: null, field_name: 'plain svg logo accepted'
  function e = 'modules/support/commands/branding/check_image', key: 'icon_url', file: good_svg
  function contract = 'modules/tests/assertions/equal', contract: contract, given: e, expected: 'modules/support/settings.errors.image_type', field_name: 'svg app icon refused (PNG only)'

  # a refused form stores nothing; a valid one stores the file and keeps its URL
  assign uploads = { "logo_url": null }
  assign uploads.logo_url = file
  assign p = { "use_host": "false", "theme_color": "blue" }
  assign p.uploads = uploads
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'upload with a bad colour refused'
  assign p = { "use_host": "true" }
  assign p.uploads = uploads
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.use_host_with_overrides', field_name: 'upload with use host ticked refused'
  assign p = { "use_host": "false", "logo_url": "https://x.test/typed.svg" }
  assign p.uploads = uploads
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: true, field_name: 'uploaded logo saved'
  function brand = 'modules/support/helpers/branding'
  assign stored = brand.logo_url | matches: '\Ahttps://\S+logo\.png'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: stored, expected: true, field_name: 'upload wins over the typed URL and is served over https'

  # the monogram icon: stored with its signature, used when there is no icon
  function s = 'modules/support/helpers/settings'
  assign original_monogram = s.branding_monogram
  assign p = { "only": "monogram", "signature": "T|rgb(1, 2, 3)" }
  assign p.monogram = file
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: true, field_name: 'monogram stored'
  assign p = { "use_host": "true" }
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function brand = 'modules/support/helpers/branding'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: brand.monogram_signature, expected: 'T|rgb(1, 2, 3)', field_name: 'monogram signature kept'
  assign uses_monogram = brand.icon_url | matches: '\Ahttps://\S+monogram\.png'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: uses_monogram, expected: true, field_name: 'no host icon: the monogram is the app icon'
  assign p = { "only": "monogram", "signature": "" }
  assign p.monogram = file
  function r = 'modules/support/commands/settings_sections/branding', params: p
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'monogram without signature refused'
  function _ = 'modules/support/commands/settings/set', key: 'branding_monogram', value: original_monogram

  # an override reaches the brand used by the rail, manifest, push and emails
  assign params = { "use_host": "false", "app_name": "Override Desk", "short_name": "Override", "support_email_name": "Override Support", "theme_color": "#123abc" }
  function saved = 'modules/support/commands/settings_sections/branding', params: params
  function contract = 'modules/tests/assertions/equal', contract: contract, given: saved.valid, expected: true, field_name: 'override saved'
  function brand = 'modules/support/helpers/branding'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: brand.app_name, expected: 'Override Desk', field_name: 'rail and manifest name'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: brand.support_email_name, expected: 'Override Support', field_name: 'email sender name'
  function f = 'support_test_helpers/ticket_fixture', label: 'brand'
  function message = 'modules/support/commands/notifications/build_message', event_key: 'assigned', ticket: f.ticket
  assign starts = message.push.title | slice: 0, 11
  function contract = 'modules/tests/assertions/equal', contract: contract, given: starts, expected: 'Override · ', field_name: 'push title carries brand'

  # invalid values refused
  assign bad = { "use_host": "false", "theme_color": "blue" }
  function r = 'modules/support/commands/settings_sections/branding', params: bad
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'bad colour refused'
  assign bad = { "use_host": "false", "logo_url": "javascript:alert(1)" }
  function r = 'modules/support/commands/settings_sections/branding', params: bad
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'non-https logo refused'

  # a new value typed with "use host branding" still ticked is refused, not dropped
  assign mixed = { "use_host": "true", "app_name": "Typed Desk" }
  function r = 'modules/support/commands/settings_sections/branding', params: mixed
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.use_host_with_overrides', field_name: 'override typed with use host refused'

  # back to the host's branding: ticking the box with the saved values still in the form
  assign reset = { "use_host": "true", "app_name": "Override Desk" }
  function r = 'modules/support/commands/settings_sections/branding', params: reset
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: true, field_name: 'ticking use host clears saved overrides'
  function brand = 'modules/support/helpers/branding'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: brand.app_name, expected: 'Harbor City Permits', field_name: 'host branding restored'

  function _ = 'modules/support/commands/settings/set', key: 'branding_override', value: original_override
%}
