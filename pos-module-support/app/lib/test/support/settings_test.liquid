{% doc %}
  @param {object} contract - The test contract object
{% enddoc %}
{% liquid
  # Assignment: whole minutes only, spam threshold 0-100 and never blank
  assign form = { "unassigned_alert_minutes": "15", "unassigned_alert_minutes_p0": "5", "escalate_after_minutes": "2.7", "spam_threshold": "5" }
  function r = 'modules/support/commands/settings_sections/save', section: 'assignment', params: form
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.minutes', field_name: 'fractional minutes refused'
  assign form.escalate_after_minutes = "30"
  assign bad_thresholds = ",abc,-3,1e9,101" | split: ','
  for bad in bad_thresholds
    assign form.spam_threshold = bad
    function r = 'modules/support/commands/settings_sections/save', section: 'assignment', params: form
    assign label = 'spam threshold refused: "' | append: bad | append: '"'
    function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.spam_threshold', field_name: label
  endfor

  # SLA hours: unknown zone, half-filled day and impossible holiday are refused
  # (all before anything is saved, so no policy is created here)
  assign sla = { "name": "Validation only", "tz": "Mars/Olympus" }
  function r = 'modules/support/commands/settings_sections/save', section: 'sla', params: sla
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.time_zone', field_name: 'unknown time zone refused without a crash'
  assign sla.tz = 'Europe/Warsaw'
  assign sla.mon_open = '09:00'
  function r = 'modules/support/commands/settings_sections/save', section: 'sla', params: sla
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.hours', field_name: 'day with one time refused'
  assign sla.mon_close = '17:00'
  assign sla.holidays = '2026-02-30'
  function r = 'modules/support/commands/settings_sections/save', section: 'sla', params: sla
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.holidays', field_name: 'impossible holiday refused'
  assign sla.holidays = '2026-13-01'
  function r = 'modules/support/commands/settings_sections/save', section: 'sla', params: sla
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.holidays', field_name: 'month 13 refused without a crash'

  # departments: duplicate name and a From address off the sending domain are refused
  graphql some = 'modules/support/departments/search', limit: 1
  assign taken = { "name": null, "inbound_local_part": "unique-validation-only" }
  assign taken.name = some.records.results.first.name | upcase
  function r = 'modules/support/commands/settings_sections/save', section: 'departments', params: taken
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.department_name_taken', field_name: 'duplicate department name refused'
  function current_settings = 'modules/support/helpers/settings'
  if current_settings.sending_domain != blank
    assign off_domain = { "name": "Validation only zz", "inbound_local_part": "unique-validation-only", "from_address": "x@not-the-sending-domain.example" }
    function r = 'modules/support/commands/settings_sections/save', section: 'departments', params: off_domain
    function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.from_domain', field_name: 'from address off the sending domain refused'
  endif

  # desk address: host and port only
  assign bad_url = { "only": "base_url", "base_url": "https://desk.example?x=1" }
  function r = 'modules/support/commands/settings_sections/save', section: 'integrations', params: bad_url
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.base_url', field_name: 'desk address with a query refused'

  # sweep watchdog: a recent run or restart leaves the chain alone, a stale one restarts it
  assign recent = 'now' | add_to_time: -2, 'm' | strftime: '%Y-%m-%dT%H:%M:%SZ'
  assign old = 'now' | add_to_time: -2, 'h' | strftime: '%Y-%m-%dT%H:%M:%SZ'
  assign fake = { "sweep_heartbeat": { "at": null }, "sweep_started_at": null }
  assign fake.sweep_heartbeat.at = recent
  assign fake.sweep_started_at = old
  function restarted = 'modules/support/commands/maintenance/watchdog', settings: fake
  function contract = 'modules/tests/assertions/equal', contract: contract, given: restarted, expected: false, field_name: 'watchdog leaves a running sweep alone'
  assign fake.sweep_heartbeat.at = old
  function restarted = 'modules/support/commands/maintenance/watchdog', settings: fake
  function contract = 'modules/tests/assertions/equal', contract: contract, given: restarted, expected: true, field_name: 'watchdog restarts a stopped sweep'
  function s = 'modules/support/helpers/settings'
  function contract = 'modules/tests/assertions/presence', contract: contract, field_name: 'sweep_started_at', object: s

  # dual secret: current accepted; previous accepted until it expires
  assign future = 'now' | add_to_time: 2, 'h' | strftime: '%Y-%m-%dT%H:%M:%SZ'
  assign past = 'now' | add_to_time: -2, 'h' | strftime: '%Y-%m-%dT%H:%M:%SZ'
  assign settings = { "previous_inbound_secret": "old-secret" }
  assign settings.previous_secret_expires_at = future
  function ok = 'modules/support/helpers/inbound_secret_valid', given: 'new-secret', current: 'new-secret', settings: settings
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ok, expected: true, field_name: 'current secret accepted'
  function ok = 'modules/support/helpers/inbound_secret_valid', given: 'old-secret', current: 'new-secret', settings: settings
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ok, expected: true, field_name: 'previous secret accepted within 24 h'
  assign settings.previous_secret_expires_at = past
  function ok = 'modules/support/helpers/inbound_secret_valid', given: 'old-secret', current: 'new-secret', settings: settings
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ok, expected: false, field_name: 'previous secret refused after expiry'
  function ok = 'modules/support/helpers/inbound_secret_valid', given: 'guess', current: 'new-secret', settings: settings
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ok, expected: false, field_name: 'wrong secret refused'

  # a status's category is locked once a ticket used it
  function f = 'support_test_helpers/ticket_fixture', label: 'settings'
  function statuses = 'modules/support/queries/statuses/all'
  assign params = { "label": "In progress", "category": "pending" }
  assign params.id = statuses.by_key.progress.id
  function changed = 'modules/support/commands/tickets/change_status', ticket: f.ticket, status_key: 'progress', actor: f.actor
  function r = 'modules/support/commands/settings_sections/status', params: params
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.category_locked', field_name: 'category locked once used'

  # departments: inbound name must be unique and well-formed
  assign params = { "name": "Clash", "inbound_local_part": "dob", "active": "true" }
  function r = 'modules/support/commands/settings_sections/department', params: params
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.error, expected: 'modules/support/settings.errors.local_part_taken', field_name: 'inbound name unique'
  assign params = { "name": "Bad", "inbound_local_part": "Not OK!" }
  function r = 'modules/support/commands/settings_sections/department', params: params
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'inbound name format'

  # only support.settings.manage opens settings: agents and managers do not have it
  function permissions = 'modules/support/queries/team/role_permissions'
  assign manager_has = false
  if permissions.manager contains 'support.settings.manage'
    assign manager_has = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: manager_has, expected: false, field_name: 'managers cannot open settings'
%}
