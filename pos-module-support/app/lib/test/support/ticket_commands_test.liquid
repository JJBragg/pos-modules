{% doc %}
  @param {object} contract - The test contract object
{% enddoc %}
{% liquid
  function f = 'support_test_helpers/ticket_fixture', label: 'cmd'
  assign actor = f.actor
  assign ticket = f.ticket

  # create: number, New, p2, audit row
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ticket.category, expected: 'new', field_name: 'created as new'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ticket.priority, expected: 'p2', field_name: 'default priority p2'
  graphql ev = 'modules/support/ticket_events/search', ticket_id: ticket.id, event_type: 'created'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ev.records.total_entries, expected: 1, field_name: 'created audit row'

  # a started ticket can go back to New: new and open behave identically in
  # helpers/categories, so this is a plain transition. The assignee and the
  # first-reply stamp survive it, which is what stops the SLA clock restarting.
  function started = 'modules/support/commands/tickets/change_status', ticket: ticket, status_key: 'progress', actor: actor
  function back = 'modules/support/commands/tickets/change_status', ticket: started.ticket, status_key: 'new', actor: actor
  function contract = 'modules/tests/assertions/valid_object', contract: contract, object: back, field_name: 'back to New allowed'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: back.ticket.category, expected: 'new', field_name: 'back to New sets the new category'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: back.ticket.assignee_id, expected: ticket.assignee_id, field_name: 'back to New keeps the assignee'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: back.ticket.first_replied_at, expected: ticket.first_replied_at, field_name: 'back to New keeps first_replied_at'
  assign ticket = back.ticket

  # pending + customer reply -> In progress
  function changed = 'modules/support/commands/tickets/change_status', ticket: ticket, status_key: 'customer', actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: changed.ticket.category, expected: 'pending', field_name: 'set pending'
  function after = 'modules/support/commands/tickets/apply_customer_reply', ticket: changed.ticket, auto_reply: false
  function contract = 'modules/tests/assertions/equal', contract: contract, given: after.category, expected: 'open', field_name: 'pending reply moves to progress'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: after.needs_reply, expected: true, field_name: 'customer reply sets needs_reply'

  # solved + customer reply -> In progress
  function changed = 'modules/support/commands/tickets/change_status', ticket: after, status_key: 'confirm', actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: changed.ticket.needs_reply, expected: false, field_name: 'solved clears needs_reply'
  function after = 'modules/support/commands/tickets/apply_customer_reply', ticket: changed.ticket, auto_reply: false
  function contract = 'modules/tests/assertions/equal', contract: contract, given: after.category, expected: 'open', field_name: 'solved reply moves to progress'

  # auto-reply changes nothing
  function changed = 'modules/support/commands/tickets/change_status', ticket: after, status_key: 'customer', actor: actor
  function after = 'modules/support/commands/tickets/apply_customer_reply', ticket: changed.ticket, auto_reply: true
  function contract = 'modules/tests/assertions/equal', contract: contract, given: after.category, expected: 'pending', field_name: 'auto-reply keeps pending'

  # every change wrote an audit row: five here, plus the two of the round trip
  # back to New above
  graphql ev = 'modules/support/ticket_events/search', ticket_id: ticket.id, event_type: 'status_changed'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ev.records.total_entries, expected: 7, field_name: 'status changes audited'

  # priority
  function p = 'modules/support/commands/tickets/set_priority', ticket: after, priority: 'p9', actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: p.valid, expected: false, field_name: 'bad priority refused'
  function p = 'modules/support/commands/tickets/set_priority', ticket: after, priority: 'p0', actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: p.ticket.priority, expected: 'p0', field_name: 'priority set'

  # assign to self works; an agent assigning someone else is refused
  function a = 'modules/support/commands/tickets/assign', ticket: p.ticket, assignee_id: actor.id, reason: null, actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: a.ticket.assignee_id, expected: actor.id, field_name: 'self assign'
  function a2 = 'modules/support/commands/tickets/assign', ticket: a.ticket, assignee_id: f.other_agent_id, reason: null, actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: a2.valid, expected: false, field_name: 'agent cannot assign others'

  # ticket page properties form: all or nothing, and Unassigned stores no assignee
  assign form = { "change": "properties", "priority": "p1", "tags": "kept", "status_key": "no-such-status", "assignee_id": "" }
  function r = 'modules/support/commands/tickets/apply_form', ticket: a.ticket, params: form, member: actor.member
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: false, field_name: 'unknown status refuses the save'
  function t = 'modules/support/queries/tickets/find', id: ticket.id, number: null, member: actor.member
  function contract = 'modules/tests/assertions/equal', contract: contract, given: t.priority, expected: 'p0', field_name: 'refused save writes nothing'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: t.assignee_id, expected: actor.id, field_name: 'refused save keeps the assignee'
  assign form.status_key = null
  function r = 'modules/support/commands/tickets/apply_form', ticket: t, params: form, member: actor.member
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: true, field_name: 'agent may unassign their own ticket'
  function t = 'modules/support/queries/tickets/find', id: ticket.id, number: null, member: actor.member
  function contract = 'modules/tests/assertions/equal', contract: contract, given: t.priority, expected: 'p1', field_name: 'priority saved with the unassign'
  function contract = 'modules/tests/assertions/equal', contract: contract, given: t.assignee_id, expected: null, field_name: 'unassigned stores null, not an empty string'
  graphql un = 'modules/support/tickets/search', id: ticket.id, assigned: false, limit: 1
  function contract = 'modules/tests/assertions/equal', contract: contract, given: un.records.total_entries, expected: 1, field_name: 'unassigned ticket is in the Unassigned filter'
  assign form = { "change": "properties", "priority": "p0", "assignee_id": "" }
  function r = 'modules/support/commands/tickets/apply_form', ticket: t, params: form, member: actor.member
  function contract = 'modules/tests/assertions/equal', contract: contract, given: r.valid, expected: true, field_name: 'saving an unassigned ticket does not re-run the assignment'
  function a = 'modules/support/commands/tickets/assign', ticket: t, assignee_id: actor.id, reason: null, actor: actor

  # @mentions in a note are matched to colleagues by full name; a longer name is not a match
  # fixture members have no profile, so their names are given through the member memo
  assign mentioned_name = 'Zedekiah Quillfeather'
  assign colleague = { "profile_id": null, "role": "agent", "department_ids": [], "name": null }
  assign colleague.profile_id = f.other_agent_id
  assign colleague.department_ids = ticket.department_id | split: ','
  assign colleague.name = mentioned_name
  assign named = []
  assign named << colleague
  export named, namespace: 'support_team_members'
  assign note_text = 'please look @' | append: mentioned_name | append: ', thanks'
  function ids = 'modules/support/queries/notes/mentioned_ids', text: note_text, ticket: ticket, author_id: actor.id
  assign hit = false
  if ids contains f.other_agent_id
    assign hit = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: hit, expected: true, field_name: 'full-name mention found'
  assign mentioned_first = mentioned_name | split: ' ' | first
  assign note_text = 'please look @' | append: mentioned_first | append: 'zz'
  function ids = 'modules/support/queries/notes/mentioned_ids', text: note_text, ticket: ticket, author_id: actor.id
  assign hit = false
  if ids contains f.other_agent_id
    assign hit = true
  endif
  function contract = 'modules/tests/assertions/equal', contract: contract, given: hit, expected: false, field_name: 'longer name is not a mention'
  assign note_text = 'cc @zedekiah'
  function ids = 'modules/support/queries/notes/mentioned_ids', text: note_text, ticket: ticket, author_id: actor.id
  function contract = 'modules/tests/assertions/equal', contract: contract, given: ids.first, expected: f.other_agent_id, field_name: 'unique first name at the end of the note is a mention'
  function _ = 'modules/support/commands/team_members/forget'

  # a reply written before the customer's latest message needs acknowledging
  assign rows = []
  assign row = { "table": "modules/support/message", "properties": { "author_type": "customer", "visibility": "public", "kind": "message", "channel": "email", "body_text": "first" } }
  assign row.properties.ticket_id = ticket.id
  assign rows << row
  graphql first_msg = 'modules/support/records/create_many', records: rows
  assign seen_id = first_msg.records.first.id
  function newer = 'modules/support/queries/messages/newer_customer_message', ticket_id: ticket.id, seen_message_id: seen_id
  function contract = 'modules/tests/assertions/equal', contract: contract, given: newer, expected: false, field_name: 'reply to the latest message needs nothing'
  graphql second_msg = 'modules/support/records/create_many', records: rows
  function newer = 'modules/support/queries/messages/newer_customer_message', ticket_id: ticket.id, seen_message_id: seen_id
  function contract = 'modules/tests/assertions/equal', contract: contract, given: newer, expected: true, field_name: 'a newer customer message is detected'

  # snooze: a malformed time is refused without a crash; clearing it is logged as unsnoozed
  function s = 'modules/support/commands/tickets/snooze', ticket: a.ticket, until: 'next tuesday-ish', actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: s.errors.until, expected: 'modules/support/tickets.errors.snooze_time', field_name: 'malformed snooze time refused'
  assign later = 'now' | add_to_time: 1, 'h' | strftime: '%Y-%m-%dT%H:%M:%SZ'
  function s = 'modules/support/commands/tickets/snooze', ticket: a.ticket, until: later, actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: s.valid, expected: true, field_name: 'snooze ok'
  function s = 'modules/support/commands/tickets/snooze', ticket: s.ticket, until: null, actor: actor
  graphql un = 'modules/support/ticket_events/search', ticket_id: ticket.id, event_type: 'unsnoozed', limit: 1
  function contract = 'modules/tests/assertions/equal', contract: contract, given: un.records.total_entries, expected: 1, field_name: 'unsnooze logged as unsnoozed'

  # tags and subject
  assign tags = "Billing, billing ,Portal" | split: ','
  assign fields = { "subject": "Renamed subject" }
  assign fields.tags = tags
  function u = 'modules/support/commands/tickets/update_fields', ticket: a.ticket, fields: fields, actor: actor
  assign tag_list = u.ticket.tags | join: ','
  function contract = 'modules/tests/assertions/equal', contract: contract, given: tag_list, expected: 'billing,portal', field_name: 'tags normalised'
  graphql by_tag = 'modules/support/tickets/search', id: ticket.id, query: 'portal', limit: 1
  function contract = 'modules/tests/assertions/equal', contract: contract, given: by_tag.records.total_entries, expected: 1, field_name: 'ticket found by its tag'
  assign retag = { "tags": ["other"] }
  function u2 = 'modules/support/commands/tickets/update_fields', ticket: u.ticket, fields: retag, actor: actor
  graphql by_old_tag = 'modules/support/tickets/search', id: ticket.id, query: 'portal', limit: 1
  function contract = 'modules/tests/assertions/equal', contract: contract, given: by_old_tag.records.total_entries, expected: 0, field_name: 'removed tag no longer matches'

  # merge moves messages and can be undone
  function f2 = 'support_test_helpers/ticket_fixture', label: 'merge'
  function note = 'modules/support/commands/messages/create_note', ticket: f2.ticket, body_html: '<p>source note</p>', mentioned_ids: null, actor: actor
  function m = 'modules/support/commands/tickets/merge', source: f2.ticket, target: u.ticket, actor: f2.manager_actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.valid, expected: true, field_name: 'merge ok'
  graphql moved_msgs = 'modules/support/messages/search', ticket_id: u.ticket.id, limit: 10
  assign moved_from = moved_msgs.records.results | map: 'moved_from_ticket_id'
  assign moved_ok = false
  if moved_from contains f2.ticket.id
    assign moved_ok = true
  endif
  function contract = 'modules/tests/assertions/true', contract: contract, value: moved_ok, field_name: 'merge moved messages', object: null
  function contract = 'modules/tests/assertions/equal', contract: contract, given: m.ticket.merged_into_id, expected: u.ticket.id, field_name: 'source points at target'
  # merging closes the ticket, so its SLA stops and no deadline is left to sort by
  function merged_source = 'modules/support/queries/tickets/find', id: f2.ticket.id, number: null, member: null
  function contract = 'modules/tests/assertions/blank', contract: contract, object: merged_source, field_name: 'sla_due_at'
  function um = 'modules/support/commands/tickets/unmerge', source: m.ticket, actor: f2.manager_actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: um.valid, expected: true, field_name: 'unmerge ok'
  graphql back = 'modules/support/messages/search', ticket_id: f2.ticket.id, limit: 10
  function contract = 'modules/tests/assertions/equal', contract: contract, given: back.records.total_entries, expected: 1, field_name: 'unmerge moved message back'
  # an unmerged ticket is open again with its SLA deadlines (the queue sorts by sla_due_at)
  function reopened = 'modules/support/queries/tickets/find', id: f2.ticket.id, number: null, member: null
  function contract = 'modules/tests/assertions/presence', contract: contract, object: reopened, field_name: 'sla_due_at'
  function contract = 'modules/tests/assertions/presence', contract: contract, object: reopened, field_name: 'sla_first_reply_due_at'

  # note is internal
  function contract = 'modules/tests/assertions/equal', contract: contract, given: note.message.visibility, expected: 'internal', field_name: 'note internal'
  function blank_note = 'modules/support/commands/messages/create_note', ticket: f2.ticket, body_html: '<p> </p>', mentioned_ids: null, actor: actor
  function contract = 'modules/tests/assertions/equal', contract: contract, given: blank_note.valid, expected: false, field_name: 'blank note refused'
%}
