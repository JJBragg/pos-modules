{% doc %}
  Board (D-26): one column per priority or per status of the view, in the
  same order as the list's swim lanes. Dragging a card to another column
  changes its priority or status.
  @param {object} page_data - From helpers/queue_page
  @param {object} member - The signed-in team_member
{% enddoc %}
{% liquid
  assign groups = page_data.groups
  assign filtered = false
  if page_data.filters.q != blank or page_data.filters.priority != blank or page_data.filters.assignee_id != blank or page_data.filters.department_id != blank
    assign filtered = true
  endif
%}
<div class="pos-support-queue" data-support-board data-support-group="{{ page_data.group }}" data-support-filtered="{{ filtered }}" data-support-departments="{{ page_data.live_departments }}" data-support-move-error="{{ 'modules/support/board.move_error' | t }}" data-support-moved="{{ 'modules/support/board.moved' | t }}">
  {% render 'modules/support/queue/head', page_data: page_data, member: member %}

  <div class="pos-support-board">
    {% for column in groups.groups %}
      <section class="pos-support-column" data-group-key="{{ column.key }}"{% if column.status %} data-status-key="{{ column.status.key }}" data-category="{{ column.status.category }}"{% else %} data-priority="{{ column.priority }}"{% endif %} aria-labelledby="col-{{ column.key }}">
        <h2 id="col-{{ column.key }}" class="pos-support-column-head">
          {% if column.priority %}
            <span class="pos-support-column-title">{% render 'modules/support/badges/priority', priority: column.priority %} {{ 'modules/support/priorities.name_' | append: column.priority | t }}</span>
          {% else %}
            {% render 'modules/support/badges/status', status: column.status %}
          {% endif %}
          <span class="pos-support-count" data-count>{{ column.total }}</span>
        </h2>
        <div class="pos-support-column-cards" data-cards data-empty="{{ 'modules/support/board.empty_column' | t }}">{% for ticket in column.tickets %}{% render 'modules/support/board/card', ticket: ticket, lookup: groups.lookup, statuses: page_data.statuses, group: page_data.group %}{% endfor %}</div>
        {% if column.expanded and column.pages > 1 %}
          {% assign column_url = '/support-desk?' | append: page_data.query | append: '&layout=board&expand=' | append: column.key | append: '&lane_page=' %}
          <nav class="pos-support-lane-pager" aria-label="{{ 'modules/support/queue.pages' | t }}">
            <span class="pos-support-tnum">{{ 'modules/support/queue.range' | t: first: column.first, last: column.last, total: column.total }}</span>
            {% if column.page > 1 %}<a href="{{ column_url }}{{ column.page | minus: 1 }}" rel="prev">{{ 'modules/support/queue.previous' | t }}</a>{% endif %}
            {% if column.page < column.pages %}<a href="{{ column_url }}{{ column.page | plus: 1 }}" rel="next">{{ 'modules/support/queue.next' | t }}</a>{% endif %}
          </nav>
        {% elsif column.expanded == false and column.total > column.tickets.size %}
          <a class="pos-button pos-button-small pos-button-ghost" href="/support-desk?{{ page_data.query }}&layout=board&expand={{ column.key }}&lane_page=1">{{ 'modules/support/board.show_more' | t: count: column.total }}</a>
        {% endif %}
      </section>
    {% endfor %}
  </div>
</div>
<script defer src="{{ 'modules/support/js/pos-support-queue.js' | asset_url }}"></script>
<script type="module" src="{{ 'modules/support/js/pos-support-board.js' | asset_url }}"></script>
