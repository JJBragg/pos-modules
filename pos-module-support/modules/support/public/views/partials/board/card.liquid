{% doc %}
  A board card. Status and priority change by dragging the card to another
  column (or on the ticket page); the assignee button bottom-right shows who
  owns the ticket and, with JavaScript, opens the assignee picker
  (pos-support-board.js, people from board/assign_people). Without
  JavaScript it links to the ticket's assignee field.
  @param {object} ticket - Ticket record
  @param {object} lookup - From queries/tickets/lookup
{% enddoc %}
{% liquid
  assign requester = lookup.contacts[ticket.requester_id]
  assign assignee = lookup.profiles[ticket.assignee_id]
  assign department = lookup.departments[ticket.department_id]
  assign status = lookup.statuses[ticket.status_id]
  assign created = ticket.created_at | to_time | strftime: '%s'
  assign assignee_name = assignee.name | default: assignee.first_name | default: assignee.email
  assign at_risk = false
  if ticket.sla_state == 'overdue' or ticket.sla_state == 'due_soon'
    assign at_risk = true
  endif
%}
<article class="pos-support-card{% if ticket.sla_state == 'overdue' %} pos-support-card-overdue{% endif %}" draggable="true" data-ticket-id="{{ ticket.id }}" data-status-key="{{ status.key }}" data-priority="{{ ticket.priority }}" data-created="{{ created }}" aria-labelledby="card-{{ ticket.id }}">
  <span class="pos-support-card-grip" aria-hidden="true">{% render 'modules/support/icon', name: 'grip-vertical', size: null %}</span>
  <p class="pos-support-card-meta">
    {% render 'modules/support/badges/priority', priority: ticket.priority %}
    <span class="pos-support-number">#{{ ticket.number }}</span>
    {%- comment -%} overdue: the red "!" pinned to the card edge that opens to "! Overdue" (handoff 3.25) {%- endcomment -%}
    {% if at_risk %}
      {% render 'modules/support/badges/sla', state: ticket.sla_state %}
    {% endif %}
  </p>
  <h3 id="card-{{ ticket.id }}" class="pos-support-card-title"><a href="/support-desk/tickets/{{ ticket.id }}">{{ ticket.subject }}</a></h3>
  <p class="pos-support-card-meta">
    {% render 'modules/support/badges/department', department: department, variant: null %}
    <span class="pos-support-card-requester">{{ requester.name | default: requester.emails.first }}</span>
    {%- if assignee -%}
      {%- assign assign_label = 'modules/support/board.assign_change' | t_escape: name: assignee_name -%}
    {%- else -%}
      {%- assign assign_label = 'modules/support/board.assign_none' | t -%}
    {%- endif %}
    <a class="pos-support-card-assignee pos-support-card-assign" href="/support-desk/tickets/{{ ticket.id }}#pos-support-side-assignee" draggable="false" data-support-assign data-assignee-id="{{ ticket.assignee_id }}" data-department-id="{{ ticket.department_id }}" aria-label="{{ assign_label }}" title="{{ assign_label }}">
      {%- if assignee -%}
        {% render 'modules/support/avatar', name: assignee_name, email: assignee.email, size: 'xs', labelled: false, profile_id: ticket.assignee_id, presence: true, role: null %}
      {%- else -%}
        {% render 'modules/support/board/unassigned_icon' %}
      {%- endif -%}
    </a>
  </p>
</article>
