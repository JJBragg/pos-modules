  circle with a person-plus glyph, the size of an xs avatar. Decorative; the
  button around it carries the name.
{% enddoc %}
<span class="pos-support-avatar pos-support-avatar-xs pos-support-unassigned" aria-hidden="true">{% render 'modules/support/icon', name: 'user-plus', size: 'sm' %}</span>
