{% doc %}
  Department marker (design review B): a tag-shaped label in the
  department's fixed colour, never the brand colour (WL-8). The text is
  always there, so the colour is never the only cue.
  @param {object} department - Department record or rail item (name, short_code, color, is_default)
  @param {string} [variant] - solid (default; list rows) | quiet (board cards: small flag + grey code) | initial (rail: first letter) | full (page header: full name)
{% enddoc %}
{%- if department -%}
{% liquid
  function color = 'modules/support/helpers/department_color', department: department
  assign code = department.short_code | default: department.name
  assign kind = variant | default: 'solid'
%}
{%- case kind -%}
  {%- when 'quiet' -%}
    <span class="pos-support-dept-quiet pos-support-dept-{{ color }}" title="{{ department.name }}"><span class="pos-support-dept-flag" aria-hidden="true"></span>{{ code }}</span>
  {%- when 'initial' -%}
    <span class="pos-support-dept pos-support-dept-initial pos-support-dept-{{ color }}" aria-hidden="true">{{ code | slice: 0 | upcase }}</span>
  {%- when 'full' -%}
    <span class="pos-support-dept pos-support-dept-full pos-support-dept-{{ color }}">{{ department.name }}</span>
  {%- else -%}
    <span class="pos-support-dept pos-support-dept-{{ color }}" title="{{ department.name }}">{{ code }}</span>
{%- endcase -%}
{%- endif -%}
