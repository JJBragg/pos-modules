{% doc %}
  Department marker (design handoff 1.1-1.6): a Gmail-like tag in the
  department's fixed colour (data-dept-color, never the brand). The text
  is always there, so the colour is never the only cue (D16).
  @param {object} department - Department record or rail item (name, short_code, color, is_default)
  @param {string} [variant] - solid (default: list rows, filters; quiet on board cards through CSS) | initial (rail: first letter, decorative) | header (queue title: full name, part of the heading) | ticket (ticket title: "Department: name")
{% enddoc %}
{%- if department -%}
{%- liquid
  function color = 'modules/support/helpers/department_color', department: department
  assign code = department.short_code | default: department.name
  assign kind = variant | default: 'solid'
  assign prefix = 'modules/support/queue.department_prefix' | t
-%}
{%- case kind -%}
  {%- when 'initial' -%}
    <span class="pos-support-dept-label" data-dept-color="{{ color }}" aria-hidden="true">{{ code | slice: 0 | upcase }}</span>
  {%- when 'header' -%}
    <span class="pos-support-dept-label pos-support-dept-label-lg" data-dept-color="{{ color }}">{{ department.name }}<span class="pos-support-sr-only">:</span></span>
  {%- when 'ticket' -%}
    <span class="pos-support-dept-label pos-support-dept-label-lg" data-dept-color="{{ color }}" title="{{ prefix }} {{ department.name }}"><span class="pos-support-sr-only">{{ prefix }} </span>{{ department.name }}<span class="pos-support-sr-only">:</span></span>
  {%- else -%}
    <span class="pos-support-dept-label" data-dept-color="{{ color }}" title="{{ department.name }}"><span class="pos-support-sr-only">{{ prefix }} </span>{{ code }}</span>
{%- endcase -%}
{%- endif -%}
