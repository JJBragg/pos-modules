{% doc %}
  One queue row; the subject link covers the whole row. A row whose last
  activity is more than a week old shows only dates, so its markup is cached
  (keyed by everything it shows); fresher rows show relative times and are
  rendered every time.
  @param {object} ticket - Ticket record
  @param {object} lookup - { contacts, organizations, profiles, departments, statuses } keyed by id
  @param {string} [link_query] - Queue view and filters, so the ticket page can offer previous/next
{% enddoc %}
{% liquid
  assign requester = lookup.contacts[ticket.requester_id]
  assign organization = lookup.organizations[ticket.organization_id]
  assign assignee = lookup.profiles[ticket.assignee_id]
  assign department = lookup.departments[ticket.department_id]
  assign status = lookup.statuses[ticket.status_id]
  assign url = '/support-desk/tickets/' | append: ticket.id
  if link_query != blank
    assign url = url | append: '?' | append: link_query
  endif
  assign requester_name = requester.name | default: requester.emails.first
  assign assignee_name = assignee.name | default: assignee.first_name | default: assignee.email

  function clock = 'modules/support/helpers/clock'
  assign activity_at = ticket.last_activity_at | default: ticket.created_at
  assign activity_epoch = activity_at | strftime: '%s' | plus: 0
  assign age = clock.now | minus: activity_epoch
  # eight days: the time partial switches from "3 d ago" to a date after seven
  assign cacheable = false
  if age > 691200
    assign cacheable = true
  endif
%}
{%- if cacheable -%}
  {%- liquid
    assign key = 'support-row|' | append: ticket.id | append: '|' | append: ticket.updated_at | append: '|' | append: link_query | append: '|' | append: clock.year | append: '|' | append: clock.zone | append: '|' | append: requester_name | append: '|' | append: requester.emails.first | append: '|' | append: organization.name | append: '|' | append: assignee_name | append: '|' | append: assignee.email | append: '|' | append: department.name | append: '|' | append: department.short_code | append: '|' | append: department.color | append: '|' | append: department.is_default | append: '|' | append: status.key | append: '|' | append: status.label | append: '|' | append: status.color
    assign key = key | digest: 'sha256'
  -%}
  {%- cache key, expire: 86400 -%}
    {%- render 'modules/support/queue/row_markup', ticket: ticket, requester: requester, organization: organization, assignee: assignee, department: department, status: status, url: url, requester_name: requester_name, assignee_name: assignee_name -%}
  {%- endcache -%}
{%- else -%}
  {%- render 'modules/support/queue/row_markup', ticket: ticket, requester: requester, organization: organization, assignee: assignee, department: department, status: status, url: url, requester_name: requester_name, assignee_name: assignee_name -%}
{%- endif -%}
