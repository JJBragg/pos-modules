{% doc %}
  Queue header shared by the list and the board: title with count, layout
  and grouping switches, attention chips and the filter bar.
  @param {object} page_data - From helpers/queue_page
  @param {object} member - The signed-in team_member
{% enddoc %}
{% liquid
  assign view = page_data.view
  assign filters = page_data.filters
  assign counts = page_data.counts
  assign view_label = 'modules/support/views.' | append: view | t
  if page_data.layout == 'board' and view == 'all_open'
    assign view_label = 'modules/support/board.title' | t
  endif
  assign base = '/support-desk?' | append: page_data.query
  # the attention chips keep the department, like the rail's view links
  assign department_suffix = ''
  assign current_department = null
  if filters.department_id != blank
    assign department_suffix = '&department_id=' | append: filters.department_id
    assign current_department = page_data.department_counts.departments | where: 'id', filters.department_id | first
  endif
  assign filtered = false
  if filters.q != blank or filters.priority != blank or filters.status_key != blank or filters.assignee_id != blank or filters.department_id != blank
    assign filtered = true
  endif
  assign sorts = "sla,priority,activity,newest,oldest" | split: ','
  assign priorities = "p0,p1,p2,p3" | split: ','
  assign layouts = "list,board" | split: ','
  assign groupings = "priority,status" | split: ','
  assign layout_icons = { "list": "list", "board": "square-kanban" }
%}
<div class="pos-support-queue-head">
  <h1 class="pos-support-title">{% if current_department %}{% render 'modules/support/badges/department', department: current_department, variant: 'header' %} {% endif %}{{ view_label }} <span class="pos-support-count-chip">{{ page_data.groups.total }}</span></h1>
  <div class="pos-support-actions">
    <nav class="pos-support-segmented" aria-label="{{ 'modules/support/queue.group_by' | t }}">
      <span class="pos-support-segmented-label">{{ 'modules/support/queue.group_by' | t }}</span>
      {% for g in groupings %}
        <a href="{{ base }}&group={{ g }}" {% if page_data.group == g %}aria-current="true"{% endif %}>{{ 'modules/support/queue.groups.' | append: g | t }}</a>
      {% endfor %}
    </nav>
    <nav class="pos-support-segmented" aria-label="{{ 'modules/support/queue.layout' | t }}">
      {% for l in layouts %}
        <a href="{{ base }}&layout={{ l }}" {% if page_data.layout == l %}aria-current="true"{% endif %}>{% render 'modules/support/icon', name: layout_icons[l], size: 'sm' %}{{ 'modules/support/queue.layouts.' | append: l | t }}</a>
      {% endfor %}
    </nav>
  </div>
</div>

<nav class="pos-support-attention" aria-label="{{ 'modules/support/queue.attention' | t }}">
  <a href="/support-desk?view=needs_reply{{ department_suffix }}" class="pos-support-attention-item pos-support-attention-reply{% if counts.needs_reply == 0 %} pos-support-attention-zero{% endif %}">{% render 'modules/support/icon', name: 'reply', size: 'sm' %}<strong>{{ counts.needs_reply }}</strong> {{ 'modules/support/views.needs_reply' | t }}</a>
  <a href="/support-desk?view=sla_at_risk{{ department_suffix }}" class="pos-support-attention-item pos-support-attention-sla{% if counts.sla_at_risk == 0 %} pos-support-attention-zero{% endif %}">{% render 'modules/support/icon', name: 'triangle-alert', size: 'sm' %}<strong>{{ counts.sla_at_risk }}</strong> {{ 'modules/support/views.sla_at_risk' | t }}</a>
  <a href="/support-desk?view=deploy{{ department_suffix }}" class="pos-support-attention-item pos-support-attention-deploy{% if counts.deploy == 0 %} pos-support-attention-zero{% endif %}">{% render 'modules/support/icon', name: 'rocket', size: 'sm' %}<strong>{{ counts.deploy }}</strong> {{ 'modules/support/views.deploy' | t }}</a>
</nav>

<form class="pos-support-toolbar pos-form" method="get" action="/support-desk" role="search" data-support-autosubmit>
  <input type="hidden" name="view" value="{{ view }}">
  <div class="pos-support-search">
    {% render 'modules/support/icon', name: 'search', size: null %}
    <label for="pos-support-q" class="pos-support-sr-only">{{ 'modules/support/queue.search' | t }}</label>
    <input type="search" id="pos-support-q" name="q" value="{{ filters.q }}" placeholder="{{ 'modules/support/queue.search_placeholder' | t }}" autocomplete="off" data-support-search>
  </div>
  {%- comment -%}
    design review E: each filter is a plain select (works without JavaScript)
    with data-support-rich-select; the hidden block after it holds each
    option's marker, rendered by the same partials as the board, which
    pos-support-select.js turns into an accessible dropdown with markers
  {%- endcomment -%}
  {% if page_data.group != 'priority' %}
    <label id="pos-support-priority-label" for="pos-support-priority" class="pos-support-sr-only">{{ 'modules/support/queue.priority' | t }}</label>
    <select id="pos-support-priority" name="priority" data-support-rich-select>
      <option value="">{{ 'modules/support/queue.any_priority' | t }}</option>
      {% for p in priorities %}<option value="{{ p }}" {% if filters.priority == p %}selected{% endif %}>{{ 'modules/support/priorities.' | append: p | t }}</option>{% endfor %}
    </select>
    <div hidden data-support-options-for="pos-support-priority">
      {% for p in priorities %}<span data-value="{{ p }}">{% render 'modules/support/badges/priority', priority: p %} {{ 'modules/support/priorities.' | append: p | t | split: '· ' | last }}</span>{% endfor %}
    </div>
  {% endif %}
  {% assign visible_departments = page_data.department_counts.departments %}
  {% if visible_departments.size > 1 %}
    <label id="pos-support-department-label" for="pos-support-department" class="pos-support-sr-only">{{ 'modules/support/queue.department' | t }}</label>
    <select id="pos-support-department" name="department_id" data-support-rich-select>
      <option value="">{{ 'modules/support/queue.any_department' | t }}</option>
      {% for d in visible_departments %}<option value="{{ d.id }}" {% if filters.department_id == d.id %}selected{% endif %}>{{ d.name }}</option>{% endfor %}
    </select>
    <div hidden data-support-options-for="pos-support-department">
      {% for d in visible_departments %}<span data-value="{{ d.id }}">{% render 'modules/support/badges/department', department: d, variant: null %} {{ d.name }}</span>{% endfor %}
    </div>
  {% elsif filters.department_id != blank %}
    <input type="hidden" name="department_id" value="{{ filters.department_id }}">
  {% endif %}
  {% if page_data.group != 'status' %}
    <label id="pos-support-status-label" for="pos-support-status" class="pos-support-sr-only">{{ 'modules/support/queue.status' | t }}</label>
    <select id="pos-support-status" name="status_key" data-support-rich-select>
      <option value="">{{ 'modules/support/queue.any_status' | t }}</option>
      {% for s in page_data.statuses %}<option value="{{ s.key }}" {% if filters.status_key == s.key %}selected{% endif %}>{{ s.label }}</option>{% endfor %}
    </select>
    <div hidden data-support-options-for="pos-support-status">
      {% for s in page_data.statuses %}<span data-value="{{ s.key }}">{% render 'modules/support/badges/status', status: s %}</span>{% endfor %}
    </div>
  {% endif %}
  {% if view != 'mine' and view != 'unassigned' %}
    {% liquid
      # an agent sees only colleagues who can hold tickets in their own departments
      assign assignee_options = []
      for m in page_data.members
        if m.profile_id == member.profile_id
          continue
        endif
        assign shares_department = true
        if member.role == 'agent' and m.role == 'agent'
          assign shares_department = false
          for d in m.department_ids
            if member.department_ids contains d
              assign shares_department = true
            endif
          endfor
        endif
        if shares_department
          assign assignee_options << m
        endif
      endfor
    %}
    <label id="pos-support-assignee-filter-label" for="pos-support-assignee-filter" class="pos-support-sr-only">{{ 'modules/support/queue.assignee' | t }}</label>
    <select id="pos-support-assignee-filter" name="assignee_id" data-support-rich-select>
      <option value="">{{ 'modules/support/queue.any_assignee' | t }}</option>
      <option value="{{ member.profile_id }}" {% if filters.assignee_id == member.profile_id %}selected{% endif %}>{{ 'modules/support/queue.assigned_to_me' | t }}</option>
      <option value="none" {% if filters.assignee_id == 'none' %}selected{% endif %}>{{ 'modules/support/ticket.unassigned' | t }}</option>
      {% for m in assignee_options %}<option value="{{ m.profile_id }}" {% if filters.assignee_id == m.profile_id %}selected{% endif %}>{{ m.name }}</option>{% endfor %}
    </select>
    <div hidden data-support-options-for="pos-support-assignee-filter">
      <span data-value="{{ member.profile_id }}">{% render 'modules/support/avatar', name: null, email: context.current_user.email, size: 'xs', labelled: false, role: null, profile_id: member.profile_id, presence: false %} {{ 'modules/support/queue.assigned_to_me' | t }}</span>
      <span data-value="none"><span class="pos-support-avatar pos-support-avatar-xs pos-support-avatar-empty" aria-hidden="true">{% render 'modules/support/icon', name: 'user-x', size: null %}</span> {{ 'modules/support/ticket.unassigned' | t }}</span>
      {% for m in assignee_options %}<span data-value="{{ m.profile_id }}">{% render 'modules/support/avatar', name: m.name, email: m.email, size: 'xs', labelled: false, role: m.role, profile_id: null, presence: false %} {{ m.name }}</span>{% endfor %}
    </div>
  {% endif %}
  <label for="pos-support-sort" class="pos-support-sr-only">{{ 'modules/support/queue.sort' | t }}</label>
  <select id="pos-support-sort" name="sort">
    {% if page_data.layout == 'board' %}<option value="">{{ 'modules/support/queue.sorts.board' | t }}</option>{% endif %}
    {% for s in sorts %}<option value="{{ s }}" {% if filters.sort == s %}selected{% endif %}>{{ 'modules/support/queue.sorts.' | append: s | t }}</option>{% endfor %}
  </select>
  <button type="submit" class="pos-button" data-support-filter-button>{% render 'modules/support/icon', name: 'filter', size: 'sm' %}{{ 'modules/support/queue.apply' | t }}</button>
  {%- comment -%} design review E: one button clears every filter, the department included; layout, grouping and sort stay {%- endcomment -%}
  {% if filtered %}<a class="pos-button pos-button-primary pos-button-icon pos-support-reset-filters" href="/support-desk?view={{ view }}" aria-label="{{ 'modules/support/queue.reset_filters' | t }}" data-tooltip="{{ 'modules/support/queue.reset_filters' | t }}" data-support-reset-filters>{% render 'modules/support/icon', name: 'refresh-ccw', size: null %}</a>{% endif %}
</form>
