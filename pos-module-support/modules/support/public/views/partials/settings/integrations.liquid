{% doc %}
  Settings → Integrations: the desk address and maintenance job health.
  @param {object} data - From queries/settings/section_data
{% enddoc %}
{% render 'modules/support/settings/nav', current: 'integrations' %}
<div class="pos-support-steps">
  <h1 class="pos-heading-2">{{ 'modules/support/settings.sections.integrations' | t }}</h1>
  <section class="pos-card pos-support-step">
    <h2 class="pos-heading-3">{{ 'modules/support/settings.sweep' | t }}</h2>
    {% if data.heartbeat.at %}
      <p {% if data.stale %}class="pos-support-error"{% endif %}>{{ 'modules/support/settings.sweep_last_label' | t }} {% render 'modules/support/time', time: data.heartbeat.at, style: 'datetime' %}</p>
    {% else %}
      <p class="pos-support-error">{{ 'modules/support/settings.sweep_never' | t }}</p>
    {% endif %}
    {% if data.stale %}<p class="pos-support-error">{{ 'modules/support/settings.sweep_stale' | t }}</p>{% endif %}
    <form action="/support-desk/settings/save" method="post">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <input type="hidden" name="section" value="integrations">
      <button type="submit" class="pos-button">{{ 'modules/support/settings.sweep_restart' | t }}</button>
    </form>
  </section>
  <section class="pos-card pos-support-step" aria-labelledby="in-base-url">
    <h2 id="in-base-url" class="pos-heading-3">{{ 'modules/support/settings.desk_address' | t }}</h2>
    <p class="pos-supplementary">{{ 'modules/support/settings.desk_address_hint' | t }}</p>
    <form action="/support-desk/settings/save" method="post" class="pos-form pos-support-settings-form">
      <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}">
      <input type="hidden" name="section" value="integrations">
      <input type="hidden" name="only" value="base_url">
      <fieldset>
        <label for="in-base">{{ 'modules/support/settings.base_url' | t }}</label>
        <input id="in-base" name="base_url" value="{{ data.settings.base_url }}" placeholder="https://{{ context.location.host }}" inputmode="url">
      </fieldset>
      <button type="submit" class="pos-button">{{ 'modules/support/settings.save' | t }}</button>
    </form>
  </section>
</div>
