---
slug: support-desk/settings/save
method: post
layout: ''
metadata:
  permission: support.settings.manage
---
{% liquid
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  unless context.csrf_request_valid
    response_status 422
    render 'modules/support/forbidden'
    break
  endunless

  assign sections = "departments,statuses,confirmation,sla,saved_replies,assignment,branding,integrations" | split: ','
  assign section = context.params.section
  unless sections contains section
    response_status 404
    render 'modules/support/forbidden'
    break
  endunless
  function result = 'modules/support/commands/settings_sections/save', section: section, params: context.params
  # the monogram icon is stored by a background fetch (pos-support-ui.js): no flash, no page
  if section == 'branding' and context.params.only == 'monogram'
    if result.valid
      response_status 204
    else
      response_status 422
    endif
    break
  endif
  if result.valid
    function _ = 'modules/user/helpers/flash', notice: result.notice, error: null, info: null, force_clear: null
  else
    function _ = 'modules/user/helpers/flash', error: result.error, notice: null, info: null, force_clear: null
  endif
  assign target_section = section | replace: '_', '-'
  if section == 'confirmation'
    assign target_section = 'statuses'
  endif
  assign target = '/support-desk/settings/' | append: target_section
  redirect_to target
%}
