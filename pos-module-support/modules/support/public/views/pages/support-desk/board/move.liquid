---
slug: support-desk/board/move
method: post
layout: ''
metadata:
  permission: support.tickets.reply
---
{% liquid
  # Change a card from the board (D-26): its status or priority (drag and
  # drop) or, with change=assign, its assignee (the card's assignee picker;
  # a blank assignee_id unassigns). The same commands and rules as the ticket
  # page. JSON for the board script, a redirect otherwise.
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  function form = 'modules/support/helpers/text_params', params: context.params, names: 'respond,ticket_id,priority,status_key,change,assignee_id'
  assign wants_json = false
  if form.respond == 'json'
    assign wants_json = true
  endif
  assign result = { "valid": false, "errors": { "status": "modules/support/board.move_error" } }
  if context.csrf_request_valid and form.ticket_id != blank
    assign member = context.exports.support.support_member
    function ticket = 'modules/support/queries/tickets/find', id: form.ticket_id, number: null, member: member
    if ticket
      assign actor = { "type": "user" }
      assign actor.id = member.profile_id
      assign actor.member = member
      # a priority column changes the priority, a status column the status
      if form.change == 'assign'
        function result = 'modules/support/commands/tickets/assign', ticket: ticket, assignee_id: form.assignee_id, reason: null, actor: actor
      elsif form.priority != blank
        function result = 'modules/support/commands/tickets/set_priority', ticket: ticket, priority: form.priority, actor: actor
      else
        function result = 'modules/support/commands/tickets/change_status', ticket: ticket, status_key: form.status_key, actor: actor
      endif
    endif
  endif

  assign error_key = result.errors.status | default: result.errors.priority | default: result.errors.assignee_id
  assign fallback_key = 'modules/support/board.move_error'
  if form.change == 'assign'
    assign fallback_key = 'modules/support/board.assign_error'
  endif
  assign message = error_key | default: fallback_key | t
  if wants_json
    response_headers '{"Content-Type": "application/json"}'
    assign body = { "ok": true, "error": null }
    unless result.valid
      response_status 422
      assign body.ok = false
      assign body.error = message
    endunless
    echo body | json | html_safe
    break
  endif
  if result.valid
    function _ = 'modules/user/helpers/flash', notice: 'modules/support/board.moved', error: null, info: null, force_clear: null
  else
    function _ = 'modules/user/helpers/flash', error: error_key, notice: null, info: null, force_clear: null
  endif
  # back to the board the form was on: the queue page in board layout or the /support-desk/board link
  assign back = '/support-desk/board'
  assign referer = context.headers.HTTP_REFERER | default: ''
  assign from_queue = referer | matches: '^https?://[^/]+/support-desk(/board)?(\?[^#]*)?$'
  if from_queue
    # only the path and query are kept, so the redirect stays on this site
    assign back = referer | replace_regex: '^https?://[^/]+', ''
  endif
  redirect_to back
%}
