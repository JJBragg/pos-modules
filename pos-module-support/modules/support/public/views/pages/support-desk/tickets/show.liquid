---
slug: support-desk/tickets/:id
layout: modules/support/support
metadata:
  permission: support.tickets.read
---
{% liquid
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/support/helpers/require_member', permission: context.page.metadata.permission, ticket: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode

  assign member = context.exports.support.support_member
  function ticket = 'modules/support/queries/tickets/find', id: context.params.id, number: null, member: member
  if ticket == blank
    response_status 404
    render 'modules/support/forbidden'
    break
  endif
  assign all_messages = false
  if context.params.thread == 'all'
    assign all_messages = true
  endif
  function data = 'modules/support/queries/tickets/page_data', ticket: ticket, member: member, profile: context.exports.support.current_profile, all_messages: all_messages
  assign title = '#' | append: ticket.number | append: ' ' | append: ticket.subject
  export title, namespace: 'support_page'
  function neighbors = 'modules/support/queries/tickets/neighbors', member: member, params: context.params, ticket_id: ticket.id
  render 'modules/support/ticket/index', data: data, neighbors: neighbors
  # a refused reply's text is shown once
  if context.session.support_reply_draft_ticket != blank
    session support_reply_draft = null
    session support_reply_draft_ticket = null
  endif
%}
