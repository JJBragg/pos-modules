{% doc %}
  Builds the brand used by the layout, emails, manifest and push (08 §3):
  Branding settings override (setting branding_override) over the host
  hook support_branding over module defaults, per key. Built once per
  request (memo in context.exports, cleared by commands/settings/set).
{% enddoc %}
{% liquid
  assign cached = context.exports.support_brand.brand
  if cached != blank
    return cached
  endif
  function settings = 'modules/support/helpers/settings'
  # background jobs have no request host; the learned desk address stands in
  assign host = context.location.host
  if host == blank and settings.base_url != blank
    assign host = settings.base_url | remove_first: 'https://' | remove_first: 'http://' | split: '/' | first
  endif
  function app_name = 'modules/support/helpers/default_app_name', host: host
  assign brand = { "app_name": app_name, "short_name": app_name, "logo_url": null, "logo_dark_url": null, "icon_url": null, "favicon_url": null, "theme_color": null, "background_color": null, "theme_mode": "auto", "rail_theme": "auto", "support_email_name": app_name }

  function host_brand = 'modules/core/commands/hook/fire', hook: 'support_branding', params: null, merge_to_object: true
  for pair in host_brand
    if pair[1] != blank
      assign brand[pair[0]] = pair[1]
    endif
  endfor

  for pair in settings.branding_override
    if pair[1] != blank
      assign brand[pair[0]] = pair[1]
    endif
  endfor

  assign brand.initial = brand.short_name | default: brand.app_name | slice: 0 | upcase

  # no icon from the host or an override: the monogram PNG an admin's browser
  # drew from the sidebar monogram (PRD WL-5); signature tells it when to redraw
  assign brand.uses_monogram = false
  if brand.icon_url == blank
    assign brand.uses_monogram = true
    assign brand.monogram_signature = settings.branding_monogram.signature
    assign brand.icon_url = settings.branding_monogram.url
  endif
  case brand.theme_mode
    when 'dark'
      # common-styling switches its dark tokens only when both classes are present
      assign brand.theme_class = 'pos-theme-dark pos-theme-darkEnabled'
    when 'light'
      assign brand.theme_class = ''
    else
      assign brand.theme_class = 'pos-theme-darkEnabled'
  endcase
  export brand, namespace: 'support_brand'
  return brand
%}
