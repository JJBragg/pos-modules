{% doc %}
  The desk gate (09 §1.2). Include it, do not call it as a function: it stops
  the page with a redirect or a 403. Sets current_profile and support_member.
  @param {string} permission - The page's metadata.permission
  @param {object} [ticket] - Ticket being accessed, for department scope
{% enddoc %}
{% liquid
  function current_profile = 'modules/user/helpers/current_profile'
  # a session opened on another form while the desk sign-in lock was on (hook_user_login)
  if context.session.support_sign_in_locked == 'true'
    graphql _ = 'modules/user/session/destroy'
    session support_sign_in_locked = null
    redirect_to '/support-desk/sign-in'
    break
  endif
  if current_profile.user == null
    session return_to = context.location.pathname
    redirect_to '/support-desk/sign-in'
    break
  endif

  function support_member = 'modules/support/helpers/resolve_member', profile: current_profile
  export support_member, current_profile, namespace: 'support'
  if support_member == null or support_member.state != 'active'
    response_status 403
    render 'modules/support/no_access', member: support_member, current_profile: current_profile
    break
  endif

  # Emails are built in background jobs that have no request host, so the desk
  # address has to be stored. It is learned once, from the first desk page
  # anyone loads, and never rewritten afterwards: comparing it to the current
  # host meant a desk reachable on two hostnames rewrote the row on every
  # request and made a GET non-idempotent. Settings -> Integrations changes it.
  function support_settings = 'modules/support/helpers/settings'
  if support_settings.base_url == blank
    assign base_url = 'https://' | append: context.location.host
    function _ = 'modules/support/commands/settings/set', key: 'base_url', value: base_url
  endif
  # a failed or lost sweep run would otherwise end the 5-minute chain for good
  function _ = 'modules/support/commands/maintenance/watchdog', settings: support_settings

  assign support_entity = { "member": support_member, "ticket": ticket }
  # platformos-check-disable ConvertIncludeToRender, UnreachableCode
  include 'modules/user/helpers/can_do_or_unauthorized', requester: current_profile, do: permission, access_callback: 'modules/support/can/desk', entity: support_entity, forbidden_partial: 'modules/support/forbidden', redirect_anonymous_to_login: false, anonymous_return_to: null
  # platformos-check-enable ConvertIncludeToRender, UnreachableCode
%}
