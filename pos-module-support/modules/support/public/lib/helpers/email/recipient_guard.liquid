{% doc %}
  Decides what may happen to an outgoing message's recipients on a
  non-production instance (#135). platformOS redirects its own email
  notifications to the instance test address, but the desk calls the
  provider API directly, so nothing rewrites the recipient for it: without
  this guard a staging instance mails real customers.

    production                         -> send unchanged
    non-production + redirect address  -> every recipient replaced by it
    non-production + allow_external    -> send unchanged (explicit opt-in)
    otherwise                          -> blocked

  @param {object} message - Provider-neutral message from commands/email/send
  @return {object} { action: send | redirect | block, message, reason }
{% enddoc %}
{% liquid
  assign result = { "action": "send", "reason": null }
  assign result.message = message

  if context.environment == 'production'
    return result
  endif

  function settings = 'modules/support/helpers/settings'
  assign redirect_to = settings.email_redirect_to | default: '' | strip

  if redirect_to != blank
    assign originals = []
    for item in message.to
      assign originals << item.email
    endfor
    for item in message.cc
      assign originals << item.email
    endfor
    assign label = originals | uniq | join: ', '

    assign recipient = { "email": null, "name": null }
    assign recipient.email = redirect_to
    assign recipient.name = message.to.first.name
    assign to = []
    assign to << recipient

    assign redirected = message | hash_merge: {}
    assign redirected.to = to
    assign redirected.cc = []
    assign prefix = 'modules/support/email_safety.subject_prefix' | t: recipients: label
    assign redirected.subject = prefix | append: ' ' | append: message.subject
    assign extra = { "X-Support-Original-To": null }
    assign extra['X-Support-Original-To'] = label
    assign existing = message.headers | default: {}
    assign redirected.headers = existing | hash_merge: extra

    assign result.action = 'redirect'
    assign result.message = redirected
    assign result.reason = label
    return result
  endif

  if settings.email_allow_external == true
    return result
  endif

  assign result.action = 'block'
  assign result.reason = 'non_production_recipient_blocked'
  return result
%}
