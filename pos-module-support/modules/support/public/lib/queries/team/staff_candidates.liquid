{% doc %}
  Host staff who could be added without an invite (09 §1.3): profiles
  whose roles are in the staff_roles setting, by default every host role
  granting admin_pages.view plus superadmin, minus current members.
  Returns [{ id, name, email }].
{% enddoc %}
{% liquid
  function settings = 'modules/support/helpers/settings'
  assign staff_roles = settings.staff_roles
  if staff_roles == blank
    function host_permissions = 'modules/user/queries/role_permissions/permissions'
    assign staff_roles = []
    for pair in host_permissions
      if pair[1] contains 'admin_pages.view'
        assign staff_roles << pair[0]
      endif
    endfor
    assign staff_roles << 'superadmin'
    assign staff_roles = staff_roles | uniq
  endif

  # every membership, in any state, is excluded: one page of 200 left later members in the list
  graphql members = 'modules/support/team_members/search', limit: 200, page: 1
  assign memberships = members.records.results
  assign pages = members.records.total_entries | plus: 199 | divided_by: 200
  # one request per page of 200, not per member or profile
  # platformos-check-disable NestedGraphQLQuery
  if pages > 1
    for page in (2..pages)
      graphql more = 'modules/support/team_members/search', limit: 200, page: page
      assign memberships = memberships | concat: more.records.results
    endfor
  endif
  assign member_ids = memberships | map: 'profile_id' | array_compact | uniq

  assign candidates = []
  assign page = 1
  for _ in (1..50)
    graphql people = 'modules/support/team/profiles_by_roles', roles: staff_roles, not_ids: member_ids, limit: 200, page: page
    for profile in people.records.results
      assign item = { "id": null, "name": null, "email": null }
      assign item.id = profile.id
      assign item.name = profile.name | default: profile.first_name | default: profile.email
      assign item.email = profile.email
      assign candidates << item
    endfor
    if page >= people.records.total_pages
      break
    endif
    assign page = page | plus: 1
  endfor
  # platformos-check-enable NestedGraphQLQuery
  return candidates
%}
