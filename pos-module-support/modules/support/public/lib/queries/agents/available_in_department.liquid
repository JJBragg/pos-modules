{% doc %}
  Agents serving a department with their open load (06 §2): active members
  whose departments include it (agents and managers), each with
  effective_availability and open_count (assigned tickets in new/open).
  Returns [{ member, profile_id, availability, open_count, max_open, last_assigned_at }].
  @param {string} department_id - The department
  @param {number} [at] - Epoch seconds for availability, default now
{% enddoc %}
{% liquid
  function members = 'modules/support/queries/team_members/all_active'
  assign candidates = []
  for member in members
    if member.role != 'admin' and member.department_ids contains department_id
      assign candidates << member
    endif
  endfor
  if candidates.size == 0
    return candidates
  endif

  # one count per candidate rather than one fetch of every open ticket they
  # hold between them: that fetch was capped at 500 records, so a department
  # past 500 open tickets tallied only the first 500 and an agent already over
  # max_open could be picked as the least loaded one
  assign open_categories = ["new", "open"]
  assign counts = {}
  for member in candidates
    # platformos-check-disable NestedGraphQLQuery
    graphql c = 'modules/support/tickets/assignee_open_count', assignee_id: member.profile_id, categories: open_categories
    # platformos-check-enable NestedGraphQLQuery
    assign counts[member.profile_id] = c.records.total_entries
  endfor

  assign agents = []
  for member in candidates
    function availability = 'modules/support/helpers/team/effective_availability', member: member, at: at
    assign agent = { "member": null }
    assign agent.member = member
    assign agent.profile_id = member.profile_id
    assign agent.availability = availability
    assign agent.open_count = counts[member.profile_id] | default: 0
    assign agent.max_open = member.max_open | default: 15
    assign agent.last_assigned_at = member.last_assigned_at
    assign agents << agent
  endfor
  return agents
%}
