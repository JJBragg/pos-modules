{% doc %}
  Rail, attention-strip and department counts read from the stored totals
  (ticket_stat) in one query, whatever the number of tickets. Returns null
  until the first full count has run. Department counts are left null when
  a filter (priority, status, assignee, organization, search) narrows the
  view: the totals are not kept per filter.
  Returns { counts, departments }, the shape of queries/tickets/rail_counts.
  @param {object} member - The acting team_member
  @param {string} view - Queue view key
  @param {object} filters - Current filters; department_id narrows the view counts only
  @param {boolean} include_waiting - In all_open, count pending and on-hold tickets too (the board)
{% enddoc %}
{% liquid
  function settings = 'modules/support/helpers/settings'
  if settings.ticket_stats_counted_at == blank
    return null
  endif

  function scope = 'modules/support/queries/tickets/scope', member: member, department_id: null
  graphql s = 'modules/support/ticket_stats/search', department_ids: scope, me: member.profile_id
  # newest row first: a duplicate row of a department, until store or the
  # hourly reconcile removes it, is never counted twice
  assign department_rows = []
  assign seen = []
  for row in s.departments.results
    unless seen contains row.department_id
      assign seen << row.department_id
      assign department_rows << row
    endunless
  endfor
  assign mine_rows = []
  assign seen = []
  for row in s.mine.results
    unless seen contains row.department_id
      assign seen << row.department_id
      assign mine_rows << row
    endunless
  endfor

  # The view counts follow what the views show: only the selected department
  # when one is selected (the rail links keep it), and All open counts the
  # waiting tickets too on the board. Department counters below always list
  # every department.
  assign keys = "needs_reply,unassigned,all_open,waiting,awaiting_confirmation,sla_at_risk,deploy" | split: ','
  assign counts = { "mine": 0 }
  for key in keys
    assign counts[key] = 0
  endfor
  assign selected = filters.department_id | default: ''
  for row in department_rows
    if selected != blank and row.department_id != selected
      continue
    endif
    for key in keys
      assign source_key = key
      if key == 'all_open' and include_waiting
        assign source_key = 'open'
      endif
      assign counts[key] = counts[key] | plus: row.counts[source_key]
    endfor
  endfor
  assign mine_by_department = {}
  for row in mine_rows
    assign mine_by_department[row.department_id] = row.counts.mine
    if selected != blank and row.department_id != selected
      continue
    endif
    assign counts.mine = counts.mine | plus: row.counts.mine
  endfor

  assign result = { "counts": null, "departments": null }
  assign result.counts = counts

  assign views = "mine,needs_reply,unassigned,all_open,waiting,awaiting_confirmation,sla_at_risk,deploy,closed" | split: ','
  assign filtered = false
  assign filter_names = "priority,status_key,assignee_id,organization_id,q" | split: ','
  for name in filter_names
    assign value = filters[name] | strip
    if value != blank
      assign filtered = true
    endif
  endfor
  unless views contains view
    assign filtered = true
  endunless
  if filtered
    return result
  endif

  assign column = view
  if view == 'all_open' and include_waiting
    assign column = 'open'
  endif
  assign by_department = {}
  assign all = 0
  if view == 'mine'
    assign by_department = mine_by_department
    assign all = counts.mine
  else
    for row in department_rows
      assign n = row.counts[column] | default: 0
      assign by_department[row.department_id] = n
      assign all = all | plus: n
    endfor
  endif

  function all_departments = 'modules/support/queries/team/can', member: member, do: 'support.tickets.manage.all'
  graphql d = 'modules/support/departments/search', limit: 100
  assign departments = { "all": 0, "departments": [] }
  assign departments.all = all
  for department in d.records.results
    unless department.active
      continue
    endunless
    unless all_departments or member.department_ids contains department.id
      continue
    endunless
    assign item = { "id": null, "name": null, "short_code": null, "color": null, "count": 0 }
    assign item.id = department.id
    assign item.name = department.name
    assign item.short_code = department.short_code
    function color = 'modules/support/helpers/department_color', department: department
    assign item.color = color
    assign item.count = by_department[department.id] | default: 0
    assign departments.departments << item
  endfor
  assign result.departments = departments
  return result
%}
