{% doc %}
  Everything the ticket page shows (05 §3). The ticket's own tables, the
  departments and the saved replies come from one request (tickets/page);
  profiles, statuses and members follow from what it returned.
  @param {object} ticket - Ticket loaded through queries/tickets/find
  @param {object} member - The signed-in team_member
  @param {object} profile - The signed-in profile
  @param {boolean} [all_messages] - Show the whole conversation instead of the newest messages
{% enddoc %}
{% liquid
  assign data = { "ticket": null, "attachments_by_message": {}, "profiles": {} }
  assign data.ticket = ticket
  assign data.me = member.profile_id

  # the newest 30 messages by default, so the page cost does not grow with
  # the thread; "show earlier" loads every message, 200 per request
  assign message_limit = 30
  assign message_order = 'DESC'
  if all_messages
    assign message_limit = 200
    assign message_order = 'ASC'
  endif
  # a blank id filter is ignored and would return the first contact
  assign requester_id = ticket.requester_id | default: '0'
  graphql r = 'modules/support/tickets/page', ticket_id: ticket.id, ticket_record_id: ticket.id, requester_id: requester_id, requester_key: requester_id, message_limit: message_limit, message_page: 1, message_order: message_order

  if all_messages
    assign messages = r.messages.results
    if r.messages.total_pages > 1
      # platformos-check-disable NestedGraphQLQuery
      for page in (2..r.messages.total_pages)
        graphql more = 'modules/support/messages/search', ticket_id: ticket.id, limit: 200, page: page
        assign messages = messages | concat: more.records.results
      endfor
      # platformos-check-enable NestedGraphQLQuery
    endif
  else
    assign messages = r.messages.results | reverse
  endif
  assign data.messages = messages
  assign data.earlier_messages = r.messages.total_entries | minus: messages.size | at_least: 0

  assign message_ids = messages | map: 'id'
  for attachment in r.attachments.results
    unless message_ids contains attachment.message_id
      continue
    endunless
    assign list = data.attachments_by_message[attachment.message_id] | default: []
    assign list << attachment
    assign data.attachments_by_message[attachment.message_id] = list
  endfor
  assign hidden = ["notified", "notification_skipped", "confirm_wait_notified"]
  assign data.events = []
  for event in r.events.results
    unless hidden contains event.event_type
      assign data.events << event
    endunless
  endfor
  assign data.links = r.links.results
  assign data.participants = r.participants.results
  assign data.requester = r.requester.results.first
  if ticket.organization_id != blank
    graphql o = 'modules/support/organizations/search', id: ticket.organization_id, limit: 1
    assign data.organization = o.records.results.first
  endif
  assign data.other_tickets = r.other_tickets.results

  assign profile_ids = []
  if ticket.assignee_id != blank
    assign profile_ids << ticket.assignee_id
  endif
  for message in data.messages
    if message.author_type == 'agent'
      assign profile_ids << message.author_id
    endif
  endfor
  for event in data.events
    if event.actor_type == 'user'
      assign profile_ids << event.actor_id
    endif
  endfor
  assign profile_ids = profile_ids | uniq | array_compact
  if profile_ids.size > 0
    graphql pr = 'modules/user/profiles/search', ids: profile_ids, limit: 100
    for item in pr.records.results
      assign data.profiles[item.id] = item
    endfor
  endif

  function statuses = 'modules/support/queries/statuses/all'
  assign data.statuses = statuses
  assign data.departments = r.departments.results
  function members = 'modules/support/queries/team_members/active'
  assign data.members = []
  assign assignee_listed = false
  for item in members
    if item.role != 'agent' or item.department_ids contains ticket.department_id
      assign data.members << item
      if item.profile_id == ticket.assignee_id
        assign assignee_listed = true
      endif
    endif
  endfor
  # the current assignee stays selectable even when they no longer serve this
  # department or are disabled, so saving another field does not unassign them
  if ticket.assignee_id != blank and assignee_listed == false
    assign current = { "profile_id": null, "name": null, "outside": true }
    assign current.profile_id = ticket.assignee_id
    assign p = data.profiles[ticket.assignee_id]
    assign current.name = p.name | default: p.first_name | default: p.email | default: ticket.assignee_id
    assign data.members << current
  endif

  function brand = 'modules/support/helpers/branding'
  assign data.saved_replies = []
  for reply in r.saved_replies.results
    if reply.department_id == blank or reply.department_id == ticket.department_id
      function html = 'modules/support/commands/saved_replies/render', saved_reply: reply, ticket: ticket, requester: data.requester, agent: profile, brand: brand
      assign item = { "id": null, "title": null, "html": null }
      assign item.id = reply.id
      assign item.title = reply.title
      assign item.html = html
      assign data.saved_replies << item
    endif
  endfor

  function can_manage = 'modules/support/queries/team/can', member: member, do: 'support.tickets.manage.all'
  assign data.can_manage = can_manage
  return data
%}
