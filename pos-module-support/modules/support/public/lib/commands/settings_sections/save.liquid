{% doc %}
  Saves one Settings form (05 §3). The form names its section and, where a
  section lists records, the record id. Returns { valid, error, notice }.
  @param {string} section - departments | statuses | confirmation | sla | saved_replies | assignment | branding | integrations
  @param {object} params - The posted form, read by name
{% enddoc %}
{% liquid
  assign result = { "valid": false, "error": null, "notice": "modules/support/settings.saved" }
  case section
  when 'departments'
    function result = 'modules/support/commands/settings_sections/department', params: params
  when 'statuses'
    function result = 'modules/support/commands/settings_sections/status', params: params
  when 'sla'
    function result = 'modules/support/commands/settings_sections/sla', params: params
  when 'saved_replies'
    function result = 'modules/support/commands/settings_sections/saved_reply', params: params
  when 'assignment'
    # every value is checked first, then only the ones that changed are written
    function current = 'modules/support/helpers/settings'
    assign integers = "unassigned_alert_minutes,unassigned_alert_minutes_p0,escalate_after_minutes" | split: ','
    assign changes = {}
    for key in integers
      # whole minutes only: '2.7' or '' is refused, not rounded or read as 0
      assign raw = params[key] | append: '' | strip
      assign whole = raw | matches: '\A\d{1,5}\z'
      assign value = raw | plus: 0
      if whole != true or value < 1 or value > 10080
        assign result.error = 'modules/support/settings.errors.minutes'
        return result
      endif
      if current[key] != value
        assign changes[key] = value
      endif
    endfor
    # a blank or non-numeric threshold would read as 0 and flag nearly every email as spam
    assign raw = params.spam_threshold | append: '' | strip
    assign numeric = raw | matches: '\A\d{1,3}(\.\d+)?\z'
    assign threshold = raw | plus: 0.0
    if numeric != true or threshold > 100
      assign result.error = 'modules/support/settings.errors.spam_threshold'
      return result
    endif
    if current.spam_threshold != threshold
      assign changes.spam_threshold = threshold
    endif
    for change in changes
      function _ = 'modules/support/commands/settings/set', key: change[0], value: change[1]
    endfor
    assign result.valid = true
  when 'confirmation'
    assign modes = ["auto_close", "keep_open"]
    assign days = params.confirmation_wait_days | plus: 0
    unless modes contains params.confirmation_mode
      assign result.error = 'modules/support/settings.errors.section'
      return result
    endunless
    if days < 1 or days > 28
      assign result.error = 'modules/support/settings.errors.confirmation_days'
      return result
    endif
    function _ = 'modules/support/commands/settings/set', key: 'confirmation_mode', value: params.confirmation_mode
    function _ = 'modules/support/commands/settings/set', key: 'confirmation_wait_days', value: days
    assign result.valid = true
  when 'branding'
    function result = 'modules/support/commands/settings_sections/branding', params: params
  when 'integrations'
    # the section has two forms; the desk address one marks itself
    if params.only == 'base_url'
      assign value = params.base_url | strip
      # a host name and an optional port only: a path, query or second line would break every link in emails
      assign valid = value | matches: '\Ahttps://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:\d{1,5})?\z'
      unless valid
        assign result.error = 'modules/support/settings.errors.base_url'
        return result
      endunless
      function _ = 'modules/support/commands/settings/set', key: 'base_url', value: value
      assign result.valid = true
    else
      function _ = 'modules/support/commands/maintenance/start_sweep'
      assign result.valid = true
      assign result.notice = 'modules/support/settings.sweep_restarted'
    endif
  else
    assign result.error = 'modules/support/settings.errors.section'
  endcase
  return result
%}
