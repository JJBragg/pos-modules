{% doc %}
  Applies one ticket-page form (05 §3). The form names its change in
  "change": properties (status, priority, assignee, department, tags),
  snooze, spam, unspam, retry (a failed reply), link, merge or unmerge. Each goes through its command, so the
  same rules, audit rows and events apply as everywhere else.
  Returns { valid, error, ticket_id, department_changed }.
  @param {object} ticket - Ticket loaded through queries/tickets/find
  @param {object} params - The posted form, read by name
  @param {object} member - The acting team_member
{% enddoc %}
{% liquid
  assign result = { "valid": true, "error": null, "ticket_id": null, "department_changed": false, "notice": null }
  assign result.ticket_id = ticket.id
  assign actor = { "type": "user" }
  assign actor.id = member.profile_id
  assign actor.member = member
  function can_manage = 'modules/support/queries/team/can', member: member, do: 'support.tickets.manage.all'

  case params.change
  when 'properties'
    # Every field is checked before anything is written, so a save is all or
    # nothing; only fields that differ are written (every write logs and broadcasts).
    function statuses = 'modules/support/queries/statuses/all'
    assign current_key = statuses.by_id[ticket.status_id].key
    assign change_status = false
    if params.status_key != blank and params.status_key != current_key
      assign change_status = true
      assign target = statuses.by_key[params.status_key]
      if target == blank or target.active == false
        assign result.valid = false
        assign result.error = 'modules/support/tickets.errors.unknown_status'
      endif
    endif
    assign change_priority = false
    if params.priority != blank and params.priority != ticket.priority
      assign change_priority = true
      assign priorities = ["p0", "p1", "p2", "p3"]
      unless priorities contains params.priority
        assign result.valid = false
        assign result.error = 'modules/support/tickets.errors.priority'
      endunless
    endif
    # the select posts '' for Unassigned; a stored '' or null both mean unassigned
    assign change_assignee = false
    if params.assignee_id != null
      assign posted_assignee = params.assignee_id | default: ''
      assign current_assignee = ticket.assignee_id | default: ''
      if posted_assignee != current_assignee
        assign change_assignee = true
        function error = 'modules/support/queries/tickets/assignee_error', ticket: ticket, assignee_id: posted_assignee, actor: actor
        if error
          assign result.valid = false
          assign result.error = error
        endif
      endif
    endif
    assign fields = { "subject": null, "department_id": null, "tags": null }
    assign changed = false
    if params.department_id != blank and params.department_id != ticket.department_id
      graphql d = 'modules/support/departments/search', id: params.department_id, limit: 1
      assign allowed = true
      if d.records.total_entries == 0
        assign allowed = false
      elsif member.role == 'agent'
        unless member.department_ids contains params.department_id
          assign allowed = false
        endunless
      endif
      if allowed
        assign fields.department_id = params.department_id
        assign changed = true
        assign result.department_changed = true
      else
        assign result.valid = false
        assign result.error = 'modules/support/tickets.errors.department'
      endif
    endif
    unless result.valid
      return result
    endunless

    if change_status
      function r = 'modules/support/commands/tickets/change_status', ticket: ticket, status_key: params.status_key, actor: actor
      assign ticket = r.ticket | default: ticket
    endif
    if change_priority
      function r = 'modules/support/commands/tickets/set_priority', ticket: ticket, priority: params.priority, actor: actor
      assign ticket = r.ticket | default: ticket
    endif
    if change_assignee
      function r = 'modules/support/commands/tickets/assign', ticket: ticket, assignee_id: posted_assignee, reason: 'manual', actor: actor
      assign ticket = r.ticket | default: ticket
    endif
    if params.tags != null
      # compared the way update_fields stores them
      assign new_tags = params.tags | split: ','
      assign normalized = []
      for tag in new_tags
        assign clean = tag | downcase | strip | truncate: 40, ''
        if clean != blank
          assign normalized << clean
        endif
      endfor
      assign new_list = normalized | uniq | join: ','
      assign old_list = ticket.tags | default: [] | join: ','
      if new_list != old_list
        assign fields.tags = new_tags
        assign changed = true
      endif
    endif
    if changed
      function r = 'modules/support/commands/tickets/update_fields', ticket: ticket, fields: fields, actor: actor
      unless r.valid
        assign result.valid = false
        assign result.error = r.errors.department_id
      endunless
    endif

  when 'snooze'
    function r = 'modules/support/commands/tickets/snooze', ticket: ticket, until: params.snooze_until, actor: actor
    unless r.valid
      assign result.valid = false
      assign result.error = r.errors.until
    endunless

  when 'spam'
    function r = 'modules/support/commands/tickets/mark_spam', ticket: ticket, actor: actor
    unless r.valid
      assign result.valid = false
      assign result.error = r.errors.status
    endunless

  when 'unspam'
    function r = 'modules/support/commands/tickets/unmark_spam', ticket: ticket, actor: actor
    unless r.valid
      assign result.valid = false
      assign result.error = r.errors.status
    endunless

  when 'retry'
    function r = 'modules/support/commands/messages/retry_delivery', ticket: ticket, message_id: params.message_id, actor: actor
    unless r.valid
      assign result.valid = false
      assign result.error = r.error
    endunless
    assign result.notice = 'modules/support/ticket.retry_sent'

  when 'link'
    function r = 'modules/support/commands/escalation_links/create', ticket: ticket, url: params.issue_url, actor: actor
    unless r.valid
      assign result.valid = false
      assign result.error = r.errors.url
    endunless

  when 'merge'
    unless can_manage
      assign result.valid = false
      assign result.error = 'modules/support/tickets.errors.merge_permission'
      return result
    endunless
    assign number = params.target_number | remove: '#' | strip | plus: 0
    function target = 'modules/support/queries/tickets/find', id: null, number: number, member: member
    if target == blank
      assign result.valid = false
      assign result.error = 'modules/support/tickets.errors.merge_target'
      return result
    endif
    function r = 'modules/support/commands/tickets/merge', source: ticket, target: target, actor: actor
    if r.valid
      assign result.ticket_id = target.id
    else
      assign result.valid = false
      assign result.error = r.errors.target
    endif

  when 'unmerge'
    unless can_manage
      assign result.valid = false
      assign result.error = 'modules/support/tickets.errors.merge_permission'
      return result
    endunless
    function r = 'modules/support/commands/tickets/unmerge', source: ticket, actor: actor
    unless r.valid
      assign result.valid = false
      assign result.error = r.errors.source
    endunless

  else
    assign result.valid = false
    assign result.error = 'modules/support/ticket.unknown_change'
  endcase
  return result
%}
