{% doc %}
  Clears the per-request memo of queries/team_members/all_active, active and
  find, and of helpers/member_roles. Call it after every team_member write, so a later read in the same
  request sees the change.
{% enddoc %}
{% liquid
  assign active = null
  assign named = null
  assign by_profile = {}
  export active, named, by_profile, namespace: 'support_team_members'
  assign map = null
  export map, namespace: 'support_member_roles'
  return true
%}
