{% doc %}
  Clears the per-request memo of queries/team_members/all_active and
  queries/team_members/find. Call it after every team_member write, so a
  later read in the same request sees the change.
{% enddoc %}
{% liquid
  assign active = null
  assign by_profile = {}
  export active, by_profile, namespace: 'support_team_members'
  return true
%}
